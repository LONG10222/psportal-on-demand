config proxy 'main'
    option enabled '0'
    option product_mode 'game'
    option source_mode 'manual'
    option openclash_source ''
    # standalone owns a separate core; openclash reuses the external core read-only
    option core_mode 'standalone'
    option listen_ip ''
    option client_ip ''
    option local_dns ''
    option bootstrap_dns ''
    option listen_port '10081'
    option backend_port '18680'
    option api_port '18681'
    option dns_port '18653'
    option idle_seconds '60'
    option wakeup_timeout '12'
    option health_interval '60'
    option health_timeout '5000'
    # Downloads are explicit: portalproxy subscription-update
    option selection_mode 'auto'
    option preferred_node ''
    option subscription_user_agent 'clash.meta'
    option subscription_url ''
    option core_path '/usr/libexec/portalproxy/mihomo'
    option routing_mark '0'
