#!/bin/sh
set -eu

cleanup() {
    [ -z "${tty_settings:-}" ] || stty "$tty_settings" 2>/dev/null || true
    [ -z "${setup_file:-}" ] || rm -f "$setup_file"
}
prompt() {
    printf '%s [%s]: ' "$1" "$2"
    IFS= read -r reply
    [ -n "$reply" ] || reply="$2"
}
get_option() { uci -q get "portalproxy.main.$1" 2>/dev/null || true; }

case "${1:-status}" in
    setup|configure)
        [ "$(id -u)" = 0 ] || { echo 'Run setup as root.' >&2; exit 1; }
        [ -t 0 ] || { echo 'Setup requires an interactive terminal.' >&2; exit 1; }
        umask 077
        setup_file="$(mktemp /tmp/portalproxy-setup.XXXXXX)"
        tty_settings="$(stty -g)"
        trap cleanup EXIT
        trap 'exit 129' HUP
        trap 'exit 130' INT
        trap 'exit 143' TERM
        prompt 'Core mode: standalone or openclash (reuse OpenClash without managing it)' "$(get_option core_mode)"; core_mode="${reply:-standalone}"
        case "$core_mode" in standalone|openclash) ;; *) echo 'Invalid core mode' >&2; exit 1 ;; esac
        detected_ip="$(uci -q get network.lan.ipaddr 2>/dev/null || true)"
        detected_ip="${detected_ip%%/*}"
        old_ip="$(get_option listen_ip)"
        prompt 'OpenWrt LAN IPv4 address' "${old_ip:-$detected_ip}"; listen_ip="$reply"
        prompt 'Portal reserved IPv4 address' "$(get_option client_ip)"; client_ip="$reply"
        dns="$(get_option local_dns)"
        [ -n "$dns" ] || dns="$(uci -q get network.lan.gateway 2>/dev/null || true)"
        prompt 'LAN DNS server (usually the main router)' "${dns:-$listen_ip}"; local_dns="$reply"
        dns="$(get_option bootstrap_dns)"
        prompt 'Working bootstrap DNS IPv4 addresses, separated by spaces' "${dns:-$local_dns}"; bootstrap_dns="$reply"
        prompt 'HTTP proxy port' "$(get_option listen_port)"; listen_port="${reply:-10081}"
        prompt 'External idle timeout in seconds' "$(get_option idle_seconds)"; idle_seconds="${reply:-60}"
        subscription_url=''; seed_file=''; routing_mark=0
        if [ "$core_mode" = standalone ]; then
        printf 'HTTPS Clash/Mihomo subscription URL (hidden; empty keeps existing): '
        stty -echo
        IFS= read -r subscription_url
        stty "$tty_settings"
        printf '\n'
        prompt 'Optional local Clash/Mihomo YAML seed file; empty skips import' ''; seed_file="$reply"
        mark="$(get_option routing_mark)"
        if [ "${mark:-0}" = 0 ] && [ -f /etc/init.d/openclash ]; then mark=6666; fi
        prompt 'Outbound routing mark (6666 for common OpenClash builds, 0 disables)' "${mark:-0}"; routing_mark="$reply"
        fi
        printf '%s\n' "$listen_ip" "$client_ip" "$local_dns" "$bootstrap_dns" "$listen_port" "$idle_seconds" "$subscription_url" "$seed_file" "$routing_mark" "$core_mode" > "$setup_file"
        /usr/bin/lua /usr/libexec/portalproxy/configure.lua "$setup_file"
        printf 'Portal HTTP proxy: %s:%s\n' "$listen_ip" "$listen_port"
        echo 'Settings saved. No service started or restarted. Run portalproxy enable when ready to start and enable at boot.'
        if [ "$core_mode" = openclash ]; then
            echo 'OpenClash must already be running before starting StarPass; its rules and DNS control final routes, including DIRECT.'
            echo 'Idle closes only our sessions. Manage nodes and subscriptions in OpenClash. HTTP proxy does not carry game UDP.'
        else
            echo 'After explicit start, the core starts only for external requests.'
            echo 'Import a seed or run portalproxy subscription-update before the first external request.'
        fi
        ;;
    nodes) exec /usr/bin/lua /usr/libexec/portalproxy/nodes.lua list ;;
    mode) shift; exec /usr/bin/lua /usr/libexec/portalproxy/workspace.lua "$@" ;;
    nodes-refresh) exec /usr/bin/lua /usr/libexec/portalproxy/nodes.lua refresh ;;
    prefer) shift; exec /usr/bin/lua /usr/libexec/portalproxy/nodes.lua set "$@" ;;
    subscription-update) exec /usr/bin/lua /usr/libexec/portalproxy/update-subscription.lua ;;
    apply)
        [ "$(id -u)" = 0 ] || exit 1
        /usr/bin/lua /usr/libexec/portalproxy/render.lua
        exec /etc/init.d/portalproxy restart
        ;;
    status) exec /usr/bin/lua /usr/libexec/portalproxy/status.lua ;;
    logs) exec /usr/bin/lua /usr/libexec/portalproxy/logs.lua ;;
    diagnose)
        /usr/bin/lua /usr/libexec/portalproxy/render.lua --check
        /usr/bin/lua /usr/libexec/portalproxy/status.lua
        exec /usr/bin/lua /usr/libexec/portalproxy/logs.lua
        ;;
    check) exec /usr/bin/lua /usr/libexec/portalproxy/render.lua --check ;;
    start|stop|restart) exec /etc/init.d/portalproxy "$1" ;;
    enable)
        [ "$(id -u)" = 0 ] || exit 1
        /usr/bin/lua /usr/libexec/portalproxy/render.lua
        uci set portalproxy.main.enabled=1
        uci commit portalproxy
        /etc/init.d/portalproxy enable
        exec /etc/init.d/portalproxy start
        ;;
    disable)
        /etc/init.d/portalproxy stop
        /etc/init.d/portalproxy disable
        uci set portalproxy.main.enabled=0
        uci commit portalproxy
        ;;
    *) echo 'Usage: portalproxy {setup|status|logs|diagnose|nodes|nodes-refresh|prefer MODE [NAME]|subscription-update|apply|check|start|stop|restart|enable|disable}' >&2; exit 2 ;;
esac
