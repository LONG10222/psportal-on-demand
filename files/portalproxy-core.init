#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
    umask 077
    local core
    core="$(uci -q get portalproxy.main.core_path)"
    [ -n "$core" ] || core=/usr/libexec/portalproxy/mihomo
    [ -x "$core" ] && [ -s /etc/portalproxy/config.yaml ] || return 1
    procd_open_instance main
    procd_set_param command "$core" -d /etc/portalproxy -f /etc/portalproxy/config.yaml
    procd_set_param user root
    [ "$(uci -q get portalproxy.main.routing_mark)" = 6666 ] && procd_set_param group nogroup
    procd_set_param respawn 3600 5 0
    procd_set_param term_timeout 2
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/portalproxy/config.yaml
    procd_close_instance
}
