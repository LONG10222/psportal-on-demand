#!/bin/sh /etc/rc.common
START=98
STOP=11
USE_PROCD=1
start_service() {
    [ "$(uci -q get portalproxy.main.gateway_enabled)" = 1 ] || return 0
    for entry in shared accelerator; do
        procd_open_instance "$entry"
        procd_set_param command /usr/bin/python3 /usr/libexec/portalproxy/gateway/entry.py "$entry"
        procd_set_param user root
        procd_set_param group nogroup
        procd_set_param respawn 3600 3 0
        procd_set_param term_timeout 3
        procd_set_param stderr 1
        procd_close_instance
    done
}
