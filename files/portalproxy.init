#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
    [ "$(uci -q get portalproxy.main.enabled)" = 1 ] || return 0
    # Accelerator workspace uses its own explicit start/account controls.
    # Boot never resumes a paid session or starts a duplicate game core.
    [ "$(uci -q get portalproxy.main.product_mode)" != accelerator ] || return 0
    umask 077
    /usr/bin/lua /usr/libexec/portalproxy/render.lua || return 1
    mkdir -p /tmp/portalproxy
    chmod 700 /tmp/portalproxy
    procd_open_instance main
    procd_set_param command /usr/bin/lua /usr/libexec/portalproxy/ondemand.lua /etc/portalproxy/policy.json
    procd_set_param user root
    [ "$(uci -q get portalproxy.main.core_mode)" != openclash ] && [ "$(uci -q get portalproxy.main.routing_mark)" = 6666 ] && procd_set_param group nogroup
    procd_set_param respawn 3600 5 0
    procd_set_param term_timeout 2
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/portalproxy /usr/libexec/portalproxy/ondemand.lua
    procd_close_instance
}

stop_service() {
    local cancellation=0
    /usr/bin/lua /usr/libexec/portalproxy/cancel-startup.lua /tmp/portalproxy || cancellation=$?
    /etc/init.d/portalproxy-core stop || return $?
    return "$cancellation"
}
