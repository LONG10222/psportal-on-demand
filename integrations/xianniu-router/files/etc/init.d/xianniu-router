#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=10

start_service() {
    config_load xianniu-router
    local enabled
    config_get_bool enabled main enabled 0
    [ "$enabled" = "1" ] || return 0
    [ -s /etc/xianniu-router/session.json ] || return 1
    procd_open_instance
    procd_set_param command /usr/bin/xianniu-router --config /etc/xianniu-router/session.json --uci --socks-port 10889 --transparent-port 10890 --dns-port 10891 --manage-routing --bypass-gid 65534 --status-file /var/run/xianniu-router.json
    procd_set_param respawn 3600 5 5
    procd_set_param term_timeout 20
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/config/xianniu-router /etc/xianniu-router/session.json
    procd_close_instance
}

stop_service() {
    xn_stopping_pid="$(ubus call service list '{"name":"xianniu-router"}' 2>/dev/null | jsonfilter -e '@.*.instances.*.pid' 2>/dev/null)"
}

service_stopped() {
    # rc.common calls this after procd sends SIGTERM. Wait for the account stop
    # request before a restart can create another session for the same game.
    local xn_wait=0
    case "$xn_stopping_pid" in
        ''|*[!0-9]*) ;;
        *) while kill -0 "$xn_stopping_pid" 2>/dev/null && [ "$xn_wait" -lt 250 ]; do
               sleep 0.1
               xn_wait=$((xn_wait + 1))
           done ;;
    esac
    /usr/bin/xianniu-router --config /etc/xianniu-router/session.json --remove-routing
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger xianniu-router
}
