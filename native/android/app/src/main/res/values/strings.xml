<resources>
    <string name="app_name">星渡 StarPass</string>
    <string name="title">星渡 StarPass</string>
    <string name="subtitle">按需局域网代理</string>
    <string name="explanation">连接同一个可信局域网。按页面显示的服务器和端口设置设备 Wi-Fi 手动 HTTP 代理。仅允许名单中的设备。</string>
    <string name="limitations">局域网手动代理仅支持 HTTP/HTTPS CONNECT，不中继 UDP 游戏或串流。后台共享开启时移出最近任务仍继续；Android 强行停止、省电或厂商限制可能中断服务。</string>
    <string name="phone_ip">本机私网 IPv4</string>
    <string name="choose_address">选择本机地址</string>
    <string name="no_address">未找到私网 IPv4，请先连接可信 Wi-Fi。</string>
    <string name="portal_ip">设备私网 IPv4</string>
    <string name="port">代理端口</string>
    <string name="subscription">HTTPS 订阅链接</string>
    <string name="subscription_help">订阅链接仅留在本次内存，不保存到设置。原生引擎可能在运行时将节点凭据缓存至应用私有目录。</string>
    <string name="lan_enabled">共享给局域网设备</string>
    <string name="phone_local_network_limit">开启本机代理后，访问家中设备等局域网功能可能不可用，直连模式也一样；关闭本机代理后恢复原来的联网方式。</string>
    <string name="phone_apps_help">默认关闭。开启并启动时需 Android VPN 授权，不能与其他 VPN 同时使用。本机代理支持 TCP/UDP；节点不支持的 UDP 会被阻断，不会自动直连。不支持 ICMP（ping），部分应用可能不兼容，加密 DNS 可能影响域名规则。</string>
    <string name="phone_apps">同时代理本机应用（可选）</string>
    <string name="vpn_notification_channel">本机应用 VPN</string>
